{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {"lunarkit": ["src/index.ts"], "lunarkit/core": ["src/core.ts"], "lunarkit/markdown": ["src/output/markdown.ts"], "lunarkit/charts": ["src/visuals/charts.ts"], "lunarkit/models": ["src/visuals/model.ts"], "lunarkit/icons/streamline": ["src/visuals/icons.ts"]}
  },
  "include": ["src", "example", "tests", "tooling", "templates/starter/src"]
}
