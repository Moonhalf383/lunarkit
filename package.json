{
  "name": "lunarkit",
  "version": "0.1.0",
  "description": "A minimal, input-driven browser terminal kit.",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/Moonhalf383/lunarkit.git" },
  "homepage": "https://github.com/Moonhalf383/lunarkit#readme",
  "bugs": { "url": "https://github.com/Moonhalf383/lunarkit/issues" },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/example*/**",
    "dist/style.css",
    "dist/fonts",
    "THIRD_PARTY_LICENSES",
    "LICENSE",
    "CHANGELOG.md",
    "docs/api.md",
    "docs/examples.md",
    "docs/compatibility.md",
    "docs/assets/lunarkit.png",
    "templates"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./markdown": {
      "types": "./dist/output/markdown.d.ts",
      "import": "./dist/markdown.js"
    },
    "./charts": {
      "types": "./dist/visuals/charts.d.ts",
      "import": "./dist/charts.js"
    },
    "./models": {
      "types": "./dist/visuals/model.d.ts",
      "import": "./dist/models.js"
    },
    "./icons/streamline": {
      "types": "./dist/visuals/icons.d.ts",
      "import": "./dist/icons/streamline.js"
    },
    "./fonts/*": "./dist/fonts/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config tooling/vite.example.ts",
    "dev:example2": "vite --config tooling/vite.example2.ts",
    "dev:example4": "vite --config tooling/vite.example4.ts",
    "preview:example4": "vite preview --config tooling/vite.example4.ts",
    "build:example4": "vite build --config tooling/vite.example4.ts",
    "dev:example3": "vite --config tooling/vite.example3.ts",
    "preview:example3": "vite preview --config tooling/vite.example3.ts",
    "preview:example2": "vite preview --config tooling/vite.example2.ts",
    "generate:fonts": "node tooling/generate-fonts.mjs",
    "build": "npm run build:lib && npm run build:example && npm run build:example2 && npm run build:example3 && npm run build:example4",
    "build:lib": "vite build --config tooling/vite.library.ts && tsc --project tsconfig.build.json && node tooling/build-assets.mjs",
    "build:example": "vite build --config tooling/vite.example.ts",
    "build:example2": "vite build --config tooling/vite.example2.ts",
    "build:example3": "vite build --config tooling/vite.example3.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node tooling/check-comments.mjs",
    "test": "vitest run --config tooling/vitest.config.ts",
    "test:e2e": "playwright test --config tooling/playwright.config.ts",
    "test:production": "playwright test --config tooling/playwright.production.ts",
    "test:acceptance": "playwright test --config tooling/playwright.acceptance.ts",
    "test:package": "node tooling/check-package.mjs",
    "test:consumer": "tsc --project tests/consumer/tsconfig.json",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:consumer && npm run test:e2e && npm run test:production",
    "prepack": "npm run build:lib"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.10.0",
    "eslint": "^10.14.0",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "@fontsource/kode-mono": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@fontsource/noto-sans-symbols-2": "^5.3.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "license": "MIT",
  "keywords": [
    "terminal",
    "browser",
    "typescript",
    "interactive-fiction",
    "portfolio",
    "sdk"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
